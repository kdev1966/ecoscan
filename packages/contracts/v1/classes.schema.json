{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecoscan.app/contracts/v1/classes.schema.json",
  "title": "EcoScan waste classes",
  "type": "object",
  "required": ["version", "classes"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "note": { "type": "string" },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "index", "datasetName", "color", "labels"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z]+$" },
          "index": { "type": "integer", "minimum": 0 },
          "datasetName": { "type": "string" },
          "color": { "type": "string", "pattern": "^#[0-9A-F]{6}$" },
          "labels": {
            "type": "object",
            "required": ["en", "fr", "ar"],
            "additionalProperties": false,
            "properties": {
              "en": { "type": "string", "minLength": 1 },
              "fr": { "type": "string", "minLength": 1 },
              "ar": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
